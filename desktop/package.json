{
  "name": "chatdesk-desktop",
  "productName": "ChatDesk 客服",
  "version": "0.1.0",
  "private": true,
  "description": "客服桌面客户端（Electron）：托盘常驻、系统通知、后端地址可配置",
  "author": "ChatDesk",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --dir"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.chatdesk.desktop",
    "productName": "ChatDesk 客服",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "identity": null
    }
  }
}
